# =============================================================
# .env.example — copy this to .env and fill in your values
# .env is gitignored and should NEVER be committed
# =============================================================

# Docker image settings 
IMAGE_NAME=ecommerce
IMAGE_VERSION=latest

# Service ports (internal container ports)
FRONTEND_PORT=8080
AUTH_PORT=8081
AD_PORT=9555
CART_PORT=7070
CHECKOUT_PORT=5050
CURRENCY_PORT=7000
EMAIL_PORT=8080
PAYMENT_PORT=50051
PRODUCT_CATALOG_PORT=3550
RECOMMENDATION_PORT=8080
SHIPPING_PORT=50051
SHOPPING_ASSISTANT_PORT=8080
REDIS_PORT=6379

# Auth service - PostgreSQL connection 
# DB_HOST must match the docker-compose service name (auth-db)
DB_HOST=auth-db
DB_PORT=5432
DB_NAME=authdb
DB_USER=postgres
DB_PASSWORD=changeme

# PostgreSQL container config (must match DB_* above) 
POSTGRES_DB=authdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# JWT secret for signing tokens
JWT_SECRET=changeme-use-a-long-random-secret-here
